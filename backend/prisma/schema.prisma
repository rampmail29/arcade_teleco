datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Game {
  id          String  @id
  title       String
  description String
  scores      Score[]
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  scores       Score[]
  achievements UserAchievement[]
  createdAt    DateTime          @default(now())
}

model Score {
  id        String   @id @default(uuid())
  value     Int
  gameId    String
  userId    String
  game      Game     @relation(fields: [gameId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([gameId])
  @@index([userId])
}

// Qué usuario desbloqueó qué logro y cuándo. Las definiciones de los logros
// (título, descripción, regla) viven en código (src/achievements/), no acá
// — esta tabla solo guarda el hecho de que se desbloqueó.
model UserAchievement {
  id          String   @id @default(uuid())
  userId      String
  achievement String
  unlockedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, achievement])
  @@index([userId])
}
